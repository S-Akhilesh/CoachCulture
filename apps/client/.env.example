NEXT_PUBLIC_COACH_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3001

# Supabase (same project for coach + client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_
# Used to verify invitations, provision links, and rate-limit auth.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Default: required in production, not required in development.
# AUTH_REQUIRE_EMAIL_CONFIRMATION=true

# Demo / mock portal. Enabled unless explicitly set to false.
# ALLOW_DEMO_PORTAL=false
