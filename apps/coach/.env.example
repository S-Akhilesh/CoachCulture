NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3001
NEXT_PUBLIC_COACH_APP_URL=http://localhost:3000

# Supabase (same project for coach + client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Required for coach self-registration via /signup.
# Leave unset to disable self-registration (manual bootstrap only).
COACH_ONBOARDING_SECRET=

# Optional. Default: required in production, not required in development.
# AUTH_REQUIRE_EMAIL_CONFIRMATION=true
