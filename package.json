{
  "name": "formfit",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n coach,client,landing -c green,cyan,magenta \"npm:dev:coach\" \"npm:dev:client\" \"npm:dev:landing\"",
    "dev:coach": "npm run dev --workspace=@formfit/coach",
    "dev:client": "npm run dev --workspace=@formfit/client",
    "dev:landing": "npm run dev --workspace=@formfit/landing",
    "build": "npm run build --workspace=@formfit/coach && npm run build --workspace=@formfit/client && npm run build --workspace=@formfit/landing",
    "build:coach": "npm run build --workspace=@formfit/coach",
    "build:client": "npm run build --workspace=@formfit/client",
    "build:landing": "npm run build --workspace=@formfit/landing",
    "lint": "npm run lint --workspaces --if-present",
    "supabase:start": "npx supabase start --exclude logflare,vector --ignore-health-check",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:push": "npx supabase db push --remote",
    "supabase:types": "npx supabase gen types typescript --remote --schema public > packages/shared/src/supabase/database.generated.ts",
    "supabase:test": "npx supabase test db"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
